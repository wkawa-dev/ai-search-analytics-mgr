#!/usr/bin/env sh
# Puts `asam` on the Bash tool's PATH when installed as a Claude Code plugin (and works from a clone).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v uvx >/dev/null 2>&1; then
  exec uvx --quiet --from "$ROOT" asam "$@"
fi
if [ -x "$ROOT/.venv/bin/asam" ]; then
  exec "$ROOT/.venv/bin/asam" "$@"
fi
echo '{"error":{"code":"UV_MISSING","message":"uv is not installed","fix":"curl -LsSf https://astral.sh/uv/install.sh | sh  (or: pip install uv)"}}'
exit 1
